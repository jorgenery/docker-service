# Arquivo .gitignore para Docker Services
# Especifica arquivos que não devem ser versionados

# Arquivos de configuração sensíveis
.env
.env.local
.env.*.local
!.env.example

# Volumes e dados
database/data/*
automation/data/*
analytics/data/*
ai/data/*
apps/data/*
monitoring/data/*
core/data/portainer/*
core/proxy/acme.json
acme.json

# Backups
database/backups/*.sql
database/backups/*.gz

# Logs
*.log
logs/
*.out

# OS e Editor
.DS_Store
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.sublime-*

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# Docker
docker-compose.override.yml
Dockerfile.local

# Certificados e chaves (se locais)
*.pem
*.key
*.cert
*.csr

# Arquivos temporários
tmp/
temp/
.tmp/
*.tmp

# Arquivos de lock (opcional - depende da política)
*.lock

# Health check logs
health-check.log

# IDE
.idea/
.vscode/
*.code-workspace

# Específico de desenvolvimento
.DEBUG
dev-notes.md
local-only.yml
